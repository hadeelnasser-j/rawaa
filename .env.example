# Optional: actual Sentinel-2 NDVI/NDMI statistics from Copernicus Data Space.
# Create an OAuth client in the Copernicus Data Space Sentinel Hub dashboard.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Optional: cookie security in hosted HTTPS deployments
RAWAA_SECURE_COOKIE=0
# Optional: database path; defaults to project data/rawaa.sqlite3
RAWAA_DB=

# Optional: persistent PostgreSQL (e.g. Neon). Leave empty to use local SQLite.
DATABASE_URL=
